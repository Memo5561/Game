<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): Auto Backup to Google Drive and device-to-device transfer.
     Backs up the durable save file (files/blocko_save.json, written by SaveStore) and all
     SharedPreferences (purchase ledger, ads-removed flag, notification flags, consent state). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="blocko_save.json" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="blocko_save.json" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
