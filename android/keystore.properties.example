# Copy this file to android/keystore.properties (it is git-ignored) and fill in your upload key.
# storeFile is relative to the android/ folder. Keep the .jks file AND the passwords safe:
# without them you cannot publish updates (unless you request an upload key reset in Play Console).
#
# Create a key once, e.g.:
#   keytool -genkeypair -v -keystore blocko-upload.jks -keyalg RSA -keysize 4096 -validity 10000 -alias upload
storeFile=blocko-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
